: "post_instructions", "contents": [{"content": "Instruction: <span class=\"bullet\">Proofread the sentence.</span>\n<span class=\"bullet\">Click on the incorrect word.</span>\n<span class=\"bullet\">Type in the correct word to complete the sentence.\n</span> <span class=\"bullet\">Use capital letters where necessary.</span>", "type": "text"}]}, {"content": 2, "type": "template_override"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}]}], "type": "GIW", "template_override": 2}, {"id": 10, "stimuli_ids": [], "questions": [{"_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "id": 0}], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}], "type": "RSLT", "template_override": 1}, {"id": 11, "stimuli_ids": [], "questions": [{"_data": [{"type": "question", "contents": [{"content": "engenn8le02ob07re7pdf01.pdf", "type": "pdf"}]}], "responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": " Do a role play and write a dialogue.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}], "type": "DWS", "template_override": 1}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "engenn8le02ob07re2img03.jpg"}, {"text": "<span class=\"strong\">Vanessa</span>: Again, I would like to say how sorry I am. I realize this was an inconvenience. A night out at a restaurant is supposed to be a positive experience.<br/>\n<span class=\"strong\">Customer</span>: Yes. It shouldn't end with salty cherry cheesecake.<br/>\n<span class=\"strong\">Vanessa</span>: I hope the other dessert we brought was to your satisfaction.<br/>\n<span class=\"strong\">Customer</span>: It was. Thank you. You ought to sue the supplier. You might want to change suppliers altogether.", "id": 1, "time": "100", "image": "engenn8le02ob07re2img03.jpg"}, {"text": "<span class=\"strong\">Vanessa</span>: They are supposed to be very reliable. They ought to trace the sugar bag back to the packaging company, though.<br/>\n<span class=\"strong\">Customer</span>: I agree. Thank you for your prompt action.<br/>\n<span class=\"strong\">Vanessa</span>: It was the least I could do. As I said earlier, your dinners are on us tonight. I hope you will come back again. <br/>\n<span class=\"strong\">Customer</span>: Yes. In fact we're supposed to come next Sunday to celebrate a birthday.<br/>\n<span class=\"strong\">Vanessa</span>: I can assure you there will be no more mishaps.", "id": 2, "time": "22500", "image": "engenn8le02ob07re2img02.jpg"}, {"text": "<span class=\"strong\">Customer</span>: There'd better not be. You might want to tell your staff to be extra careful for a while. <br/>\n<span class=\"strong\">Vanessa</span>: Yes. I realize I should  be on top of everything. However, salt in the sugar bag is way beyond my control. Again, I humbly apologize for the unforeseeable hitch in your evening. <br/>\n<span class=\"strong\">Customer</span>: By the way. You might want to go easy on the young chef. He looked terrified.<br/>\n<span class=\"strong\">Vanessa</span>: I'll take that into account.", "id": 3, "time": "46000", "image": "engenn8le02ob07re2img05.jpg"}], "audiosrc": "engenn8le02ob07re2aud01", "coverimg": "engenn8le02ob07re2img03.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}]}]}