pe": "text", "content": ""}]}], "id": 0, "_data": [{"type": "question", "contents": [{"type": "text", "content": ""}]}]}], "template_override": 1, "id": 10, "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"type": "group_name", "content": "Quiz"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}]}, {"stimuli_ids": [], "type": "DWS", "questions": [{"responses": [{"correct": 1, "id": 0, "selected": 0, "_data": [{"type": "text", "content": ""}]}], "id": 0, "_data": [{"type": "question", "contents": [{"type": "pdf", "content": "engenn8le02ob02re7pdf01.pdf"}]}]}], "template_override": 1, "id": 11, "_data": [{"type": "instructions", "contents": [{"type": "text", "content": " Do a restaurant role play!"}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Take Away"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: Complete the following steps. Fill in the Self Assessment."}]}]}], "type": "scholar", "stimuli": [{"type": "welcome", "contents": [{}], "template_override": 1, "id": 0, "_data": []}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn8le02ob02re2img05.jpg", "audiosrc": "engenn8le02ob02re2aud01", "images": [{"time": "0", "image": "engenn8le02ob02re2img05.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn8le02ob02re2img05.jpg", "id": 1, "text": "<span class=\"strong\">Vanessa</span>: Good evening. Can I help you?<br/>\n<span class=\"strong\">Melinda</span>: Hello. I'm waiting for someone.<br/>\n<span class=\"strong\">Vanessa</span>: Is it a Mr Brown? <br/>\n<span class=\"strong\">Melinda</span>: Yes. We're meeting here. He's buying me a nice dinner. Then, I'm leaving.<br/>\n<span class=\"strong\">Vanessa</span>: Oh. Do you need to go somewhere else?<br/>\n<span class=\"strong\">Melinda</span>: No. I'm going to break up with him. My train home leaves at 11:30. I want to be on it."}, {"time": "20200", "image": "engenn8le02ob02re2img05.jpg", "id": 2, "text": "<span class=\"strong\">Vanessa</span>: Won't he be upset?<br/>\n<span class=\"strong\">Melinda</span>: He'll get over it. How late do you serve?<br/>\n<span class=\"strong\">Vanessa</span>: The kitchen serves until midnight all week.<br/>\n<span class=\"strong\">Melinda</span>: Hmmm. Could you make sure our dinner comes quickly?<br/>\n<span class=\"strong\">Vanessa</span>: Certainly. I can do that.<br/>\n<span class=\"strong\">Melinda</span>: Would you also make sure the wine keeps coming? I'd like him as happy as possible. <br/>\n<span class=\"strong\">Vanessa</span>: Of course, Miss."}, {"time": "38000", "image": "engenn8le02ob02re2img01.jpg", "id": 3, "text": "<span class=\"strong\">Melinda</span>: Here's my credit card. Would you please bill me for the second bottle and a very elaborate second dessert? He'll want trifle or mousse or tiramisu. He's going to want to eat more after I tell him.<br/>\n<span class=\"strong\">Vanessa</span>: Thanks. Now I'll take you over to Mr Brown.<br/>\n<span class=\"strong\">Melinda</span>: Are you staying and taking our order as well?<br/>\n<span class=\"strong\">Vanessa</span>: I'd be happy to do that. Come this way please.<br/>\n<span class=\"strong\">Melinda</span>: Edmund darling. Miss?<br/>\n<span class=\"strong\">Vanessa</span>: What can I do for you?<br/>\n<span class=\"strong\">Melinda</span>: We'll have two large steaks, with baked potatoes and a large caesar salad to start please.<br/>\n<span class=\"strong\">Vanessa</span>: I'll take care of that right away. Would you sign here please?<br/>\n<span class=\"strong\">Melinda</span>: Of course."}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}], "id": 0, "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Vanessa and the Customer Complaint"}, {"type": "unit_name", "content": "What Would You Like? "}, {"type": "position", "content": 2}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 2}, {"type": "level", "content": "B1.3"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Exchange information using a wider range of language."}, {"type": "secondary_1", "content": "Understands important and specific information conversations, texts or presentations about the communicative functions related to this level. "}, {"type": "secondary_2", "content": "Understands important and specific information conversations, texts or presentations about the communicative functions related to this level. "}, {"type": "secondary_3", "content": "Understands important and specific information conversations, texts or presentations about the communicative functions related to this level. "}, {"type": "secondary_4", "content": "Understands important and specific information conversations, texts or presentations about the communicative functions related to this level. "}, {"type": "secondary_5", "content": "Understands important and specific information conversations, texts or presentations about the communicative functions related to this level. "}, {"type": "secondary_6", "content": "Understands important and specific information conversations, texts or presentations about the communicative functions related to this level. "}, {"type": "secondary_7", "content": "Understands important and specific information conversations, texts or presentations about the communicative functions related to this level. "}, {"type": "secondary_8", "content": "Understands important and specific information conversations, texts or presentations about the communicative functions related to this level. "}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Asking For and Providing Information"}, {"type": "describer", "content": "When you ask for information, you can use either <span class=\"strong\">WH-questions</span> or <span class=\"strong\">Yes-No questions</span> depending on what information you ask for."}, {"type": "text", "content": "When you provide information, you give facts. You may do this with with future tenses: <span class=\"italic\">will, going to, the Present Continuous</span> or <span class=\"italic\">the Present Simple</span>."}, {"type": "table", "content": "{\"rows\":5,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Asking for Information\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Providing Information\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Can you show me my table?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Sure. It's at the back of the restaurant.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Is it an important meeting?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Yes. We're meeting a new employee today.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"How late does the kitchen serve?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"The kitchen serves until 11:00 p.m.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Won't he help me?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"He'll help you when she arrives.\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}, {"type": "example", "content": "<span class=\"strong\">Vanessa</span>: Is it a Mr. Brown?<br/><span class=\"strong\">Melinda</span>: Yes. We're meeting here. We'll eat, then, I'm leaving."}, {"type": "example", "content": "<span class=\"strong\">Vanessa</span>: Oh. Do you need to go somewhere else?<br/><span class=\"strong\">Melinda</span>: No. I'm breaking up with him."}, {"type": "example", "content": "<span class=\"strong\">Vanessa</span>:  Won't he be upset?<br/><span class=\"strong\">Melinda</span>: He'll get over it."}, {"type": "example", "content": "<span class=\"strong\">Vanessa</span>: How late do you serve?<br/><span class=\"strong\">Melinda</span>: The kitchen serves until midnight all week."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Making Polite Requests"}, {"type": "describer", "content": "When you make polite requests in a work environment, you can use the modals <span class=\"italic\">could</span> and <span class=\"italic\">would</span>."}, {"type": "text", "content": "You use these phrases to make requests:<br/><ul> \t<li>Could you + base form of the verb ... ?</li> \t<li>Would you + base form of the verb ... ?</li> \t </ul>"}, {"type": "example", "content": "<span class=\"strong\">Customer</span>: Could you make sure our dinner comes quickly?<br/><span class=\"strong\">Waiter</span>: Certainly. I can do that."}, {"type": "example", "content": "<span class=\"strong\">Customer</span>: Would you also make sure the wine keeps coming?<br/>  <span class=\"strong\">Waiter</span>: Of course, Miss."}, {"type": "example", "content": "<span class=\"strong\">Customer</span>: Would you please bill me for the second bottle and a very elaborate second dessert?<br/>  <span class=\"strong\">Waiter</span>: I'll take care of that right away."}, {"type": "example", "content": "<span class=\"strong\">Waiter</span>: Would you sign here please? <br/><span class=\"strong\">Customer</span>: Of course."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "credit card"}, {"type": "definition", "content": "a card to use in place of cash"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Please use my credit card to bill me for dinner. "}, {"type": "audio", "content": "engenn8le02ob02aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you use to talk about food in a restaurant."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "trifle"}, {"type": "definition", "content": "a dessert made with custard, fruit and whipping cream"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: We have an excellent trifle for dessert tonight."}, {"type": "audio", "content": "engenn8le02ob02aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "mousse"}, {"type": "definition", "content": "a light dessert made with eggs and cream"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: This is a chocolate mousse and this is a strawberry mousse."}, {"type": "audio", "content": "engenn8le02ob02aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "tiramisu"}, {"type": "definition", "content": "a dessert made with soft cheese and coffee"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The tiramisu is made with a traditional Italian recipe."}, {"type": "audio", "content": "engenn8le02ob02aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "darling"}, {"type": "definition", "content": "a term of endearment"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Thank you so much Edmund, darling."}, {"type": "audio", "content": "engenn8le02ob02aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "baked potato"}, {"type": "definition", "content": "a potato cooked whole in the oven"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Can we have a baked potato with our steak please?"}, {"type": "audio", "content": "engenn8le02ob02aud06"}]}, {"type": "background_image", "content": "engenn8le02ob02re1img01.jpg"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Write a short dialogue."}, {"type": "text", "content": "With a friend, imagine you are in a restaurant."}, {"type": "text", "content": "Imagine one of you is a waiter/waitress and the other person is a customer."}, {"type": "text", "content": "Have a conversation between the waiter/waitress and customer."}, {"type": "text", "content": "The customer asks  about the food.The waiter/waitress should answer the questions politely and recommend something from the menu."}, {"type": "text", "content": "Practice the dialogue with a partner."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I write a dialogue between a customer and waiter in a restaurant."}, {"type": "text", "content": "I ask questions about food."}, {"type": "text", "content": "I recommend food to a customer."}]}]}