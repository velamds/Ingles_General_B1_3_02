[{"content": "won't", "type": "text"}]}, {"type": "post_question", "contents": {"content": "give you a refund on your dinner.", "type": ""}}, {"content": "secondary_8", "type": "objective"}], "responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "will", "type": "text"}], "selected": 0, "correct": 1}], "id": 2}], "_data": [{"type": "instructions", "contents": [{"content": " The owner of the restaurant speaks to a family about their bill.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "post_instructions", "contents": [{"content": "Instructions: <span class=\"bullet\">Listen to the audio.\n<span class=\"bullet\">Proofread the sentence. </span> \n<span class=\"bullet\">Click on the incorrect word. </span> \n<span class=\"bullet\">Type in the correct word to complete the sentence.</span>\n<span class=\"bullet\">Use capital letters where necessary. </span>", "type": "text"}, {"content": "engenn8le02ob08re6aud01", "type": "audio"}]}, {"content": 2, "type": "template_override"}, {"type": "learning_skills", "contents": [{"content": "Listening", "type": "skill"}, {"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}]}], "type": "GIW", "template_override": 2}, {"id": 10, "stimuli_ids": [], "questions": [{"_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "id": 0}], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}], "type": "RSLT", "template_override": 1}, {"id": 11, "stimuli_ids": [], "questions": [{"_data": [{"type": "question", "contents": [{"content": "engenn8le02ob08re7pdf01.pdf", "type": "pdf"}]}], "responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": "Time to help out a friend or family member with a letter of complaint.  Can you remember what to include?", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Speaking", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Reading", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}], "type": "DWS", "template_override": 1}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "engenn8le02ob08re2img01.jpg"}, {"text": "Anthony Bussan<br/>\n34 Grove Street <br/>\nBoston, Massachusetts<br/><br/>Derek Stevens, Restaurant Manager at <span class=\"italic\">Cristoff's</span><br/>\n45 Turin Ave. <br/>\nBoston, Massachusetts<br/><br/>Dear Sir,<br/>", "id": 1, "time": "100", "image": "engenn8le02ob08re2img01.jpg"}, {"text": "I am writing to tell you about a problem my family and I had at your restaurant the last time we were there. On Friday, I came to <span class=\"italic\">Cristoff's</span>  with my wife and our five-year-old daughter Jane. We will never come back or recommend your establishment. Furthermore, we are going to complete an online review so that others are wary of deceptive advertising techniques.", "id": 2, "time": "18000", "image": "engenn8le02ob08re2img01.jpg"}, {"text": "<span class=\"italic\">Cristoff's</span> is supposed to be a family restaurant. In your advertisements, you say that children that eat at <span class=\"italic\">Cristoff's</span> are served child-sized portions, and are provided with coloring books and crayons. You also tell customers that each child in the restaurant is given special attention. However, when my family ate at <span class=\"italic\">Christoff's</span> on Friday, we were told that child-sized portions were not available on Friday nights.", "id": 3, "time": "39000", "image": "engenn8le02ob08re2img02.jpg"}, {"text": "My daughter was not given a coloring book or crayons. When she got restless and began to cry, we got complaints from the staff and patrons in the restaurant. I was even chastised for taking my daughter to a restaurant after 7PM! This meal was supposed to be a celebration of a long, hard week. Instead, we should have stayed home.", "id": 4, "time": "64000", "image": "engenn8le02ob08re2img02.jpg"}, {"text": "I think the behavior of the staff was shameful. I hope you feel terrible about it. I am not sure, sir, if any apology can make up for the unpleasant treatment we received. I am also planning to contact the newspaper that published the advertisements.  I will be sure to spread the word to them and others about this atrocious scam. <br/><br/>Anthony Bussan", "id": 5, "time": "85000", "image": "engenn8le02ob08re2img04.jpg"}], "audiosrc": "engenn8le02ob08re2aud01", "coverimg": "engenn8le02ob08re2img01.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}, {"id": 2, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": ""}, {"text": "<span class=\"bullet\"> What do you include in a letter of complaint?</span>", "id": 1, "time": "31000", "image": ""}, {"text": "<span class=\"bullet\">How do you respond to a letter of complaint?</span>", "id": 2, "time": "110000", "image": ""}], "video_src": "engenn8le02ob08vid01"}, "type": "video"}], "_data": [], "type": "video", "template_override": 1}]}]}