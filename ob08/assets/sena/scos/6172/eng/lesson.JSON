": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: <span class=\"bullet\">Listen to the audio.</span> <span class=\"bullet\">Type in the missing words. </span><span class=\"bullet\">Record yourself saying the sentences aloud. </span><span class=\"bullet\">Compare yourself to the audio.</span><br/>You have 2 attempts to submit your answers.", "type": "text"}]}], "type": "TYP", "template_override": 1}, {"id": 4, "stimuli_ids": [2], "questions": [{"_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}, {"content": "secondary_3", "type": "objective"}], "responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "id": 0}, {"_data": [{"type": "question", "contents": [{"content": "Your address:", "type": "text"}]}, {"content": "secondary_3", "type": "objective"}], "responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "id": 1}, {"_data": [{"type": "question", "contents": [{"content": "The address of the restaurant:", "type": "text"}]}, {"content": "secondary_3", "type": "objective"}], "responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "id": 2}, {"_data": [{"type": "question", "contents": [{"content": "Greeting:", "type": "text"}]}, {"content": "secondary_3", "type": "objective"}], "responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "id": 3}, {"_data": [{"type": "question", "contents": [{"content": "Body of Letter:", "type": "text"}]}, {"content": "secondary_3", "type": "objective"}], "responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "id": 4}, {"_data": [{"type": "question", "contents": [{"content": "Closing:", "type": "text"}]}, {"content": "secondary_3", "type": "objective"}], "responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "id": 5}], "_data": [{"type": "instructions", "contents": [{"content": "<span class=\"strong\">Anthony expressed his disappointment in a letter of complaint. Can you do the same?\n", "type": "text"}, {"content": "<span class=\"italic\">Instructions</span>:<br/><span class=\"bullet\">Imagine you went to <span class=\"italic\">Christoff's</span> on the same evening as the Bussan's and also received terrible service.</span><br/>\n<span class=\"bullet\">These are the issues you encountered at the restaurant.<br/><br/>\n\n<ul><li>The waiter was rude.</li>\n<li>The food was cold.</li>\n<li>You were not given the discount mentioned in the advertisement.</li>\n</ul>\n<span class=\"bullet\">Write a 120- to 150-word complaint letter to the manager of the restaurant.<br/>\n<span class=\"bullet\">Write in letter structure.<br/>\n<span class=\"bullet\">Express your feelings and reactions to the treatment you received.<br/>\n<span class=\"bullet\">Write sentences that talk about future actions with will, going to, Present Continuous tense and Present tense.<br/>\n<span class=\"bullet\">When you have typed in ALL your answers, click the <span class=\"strong\">Go to Writing Task</span> button.<br/>\n", "type": "text"}, {"content": "<br/><span class=\"strong\">My Letter of Complaint</span>", "type": "text"}]}, {"type": "group", "contents": [{"content": "Activity 3", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Listening", "type": "skill"}]}, {"type": "instructions", "contents": [{"content": "<span class=\"strong\">It's time to review your letter of complaint.</span><br/><br/>\nWhen you are writing a letter of complaint, remember to:<br/>\n\n\n<ul><li>Use letter structure.</li>\n<li>Explain what happened, where it happened and when it happened.</li>\n<li>Express your feelings and reactions.</li>\n<li>Write about the future using will, going to, Present Continuous tense and Present tense.</li></ul><br/>\n\nProofread your letter for any spelling, grammar or punctuation errors.<br/>\nRead your letter aloud to a partner.<br/><br/>\n\nClick the <span class=\"strong\">Submit</span> button to save your work.", "type": "text"}]}, {"grading_contents": {"header": {"rows": [{"cells": [{"content": "", "colspan": 1, "content_type": "text", "element": "th"}, {"content": "", "colspan": 5, "content_type": "text", "element": "th"}]}, {"cells": [{"content": "", "colspan": 1, "content_type": "text", "element": "th"}, {"content": "", "colspan": 1, "content_type": "text", "element": "th"}, {"content": "", "colspan": 1, "content_type": "text", "element": "th"}, {"content": "", "colspan": 1, "content_type": "text", "element": "th"}, {"content": "", "colspan": 1, "content_type": "text", "element": "th"}]}]}, "body": {"rows": [{"cells": [{"content": "", "colspan": 1, "content_type": "text", "element": "th"}, {"content": [" "], "points": "20", "colspan": 1, "content_type": "text", "element": "th"}, {"content": [" "], "points": "20", "colspan": 1, "content_type": "text", "element":