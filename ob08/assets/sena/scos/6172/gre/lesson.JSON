selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "apologize", "type": "text"}], "id": 1}], "_data": [{"type": "question", "contents": [{"content": "I", "type": "text"}]}, {"type": "incorrect", "contents": [{"content": "apoligize", "type": "text"}]}, {"type": "post_question", "contents": {"content": ". You are", "type": ""}}, {"content": "secondary_8", "type": "objective"}], "id": 0}, {"responses": [{"correct": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "supposed", "type": "text"}], "id": 1}], "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}, {"type": "incorrect", "contents": [{"content": "suposed", "type": "text"}]}, {"type": "post_question", "contents": {"content": "to receive a free dessert with your meal.", "type": ""}}, {"content": "secondary_8", "type": "objective"}], "id": 1}, {"responses": [{"correct": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "will", "type": "text"}], "id": 1}], "_data": [{"type": "question", "contents": [{"content": "We", "type": "text"}]}, {"type": "incorrect", "contents": [{"content": "won't", "type": "text"}]}, {"type": "post_question", "contents": {"content": "give you a refund on your dinner.", "type": ""}}, {"content": "secondary_8", "type": "objective"}], "id": 2}], "_data": [{"type": "instructions", "contents": [{"content": " The owner of the restaurant speaks to a family about their bill.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "post_instructions", "contents": [{"content": "Instructions: <span class=\"bullet\">Listen to the audio.\n<span class=\"bullet\">Proofread the sentence. </span> \n<span class=\"bullet\">Click on the incorrect word. </span> \n<span class=\"bullet\">Type in the correct word to complete the sentence.</span>\n<span class=\"bullet\">Use capital letters where necessary. </span>", "type": "text"}, {"content": "engenn8le02ob08re6aud01", "type": "audio"}]}, {"content": 2, "type": "template_override"}], "stimuli_ids": [], "template_override": 2, "id": 9, "type": "GIW"}, {"questions": [{"responses": [{"correct": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 1}], "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}], "stimuli_ids": [], "template_override": 1, "id": 10, "type": "RSLT"}, {"questions": [{"responses": [{"correct": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}], "_data": [{"type": "question", "contents": [{"content": "engenn8le02ob08re7pdf01.pdf", "type": "pdf"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": "Time to help out a friend or family member with a letter of complaint.  Can you remember what to include?", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Speaking", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Reading", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self Assessment.", "type": "text"}]}], "stimuli_ids": [], "template_override": 1, "id": 11, "type": "DWS"}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "type": "scholar", "stimuli": [{"_data": [], "contents": [{}], "template_override": 1, "type": "welcome", "id": 0}, {"template_override": 1, "title": "", "contents": [{"type": "slideshow", "value": {"coverimg": "engenn8le02ob08re2img01.jpg", "audiosrc": "engenn8le02ob08re2aud01", "images": [{"time": "0", "image": "engenn8le02ob08re2img01.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn8le02ob08re2img01.jpg", "id": 1, "text": "Anthony Bussan<br/>\n34 Grove Street <br/>\nBoston, Massachusetts<br/><br/>Derek Stevens, Restaurant Manager at <span class=\"italic\">Cristoff's</span><br/>\n45 Turin Ave. <br/>\nBoston, Massachusetts<br/><br/>Dear Sir,<br/>"}, {"time": "18000", "image": "engenn8le02ob08re2img01.jpg", "id": 2, "text": "I am writing to tell you about a problem my family and I had at your restaurant the last time we were there. On Friday, I came to <span class=\"italic\">Cristoff's</span>  with my wife and our five-year-old daughter Jane. We will never come back or recommend your establishment. Furthermore, we are going to complete an online review so that others are wary of deceptive advertising techniques."}, {"time": "39000", "image": "engenn8le02ob08re2img02.jpg", "id": 3, "text": "<span class=\"italic\">Cristoff's</span> is supposed to be a family restaurant. In your advertisements, you say that children that eat at <span class=\"italic\">Cristoff's</span> are served child-sized portions, and are provided with coloring books and crayons. You also tell customers that each child in the restaurant is given special attention. However, when my family ate at <span class=\"italic\">Christoff's</span> on Friday, we were told that child-sized portions were not available on Friday nights."}, {"time": "64000", "image": "engenn8le02ob08re2img02.jpg", "id": 4, "text": "My daughter was not given a coloring book or crayons. When she got restless and began to cry, we got complaints from the staff and patrons in the restaurant. I was even chastised for taking my daughter to a restaurant after 7PM! This meal was supposed to be a celebration of a long, hard week. Instead, we should have stayed home."}, {"time": "85000", "image": "engenn8le02ob08re2img04.jpg", "id": 5, "text": "I think the behavior of the staff was shameful. I hope you feel terrible about it. I am not sure, sir, if any apology can make up for the unpleasant treatment we received. I am also planning to contact the newspaper that published the advertisements.  I will be sure to spread the word to them and others about this atrocious scam. <br/><br/>Anthony Bussan"}]}}], "_data": [], "id": 1, "type": "audio"}, {"template_override": 1, "title": "", "contents": [{"type": "video", "value": {"images": [{"time": "0", "image": "", "id": 0, "text": ""}, {"time": "31000", "image": "", "id": 1, "text": "<span class=\"bullet\"> What do you include in a letter of complaint?</span>"}, {"time": "110000", "image": "", "id": 2, "text": "<span class=\"bullet\">How do you respond to a letter of complaint?</span>"}], "video_src": "engenn8le02ob08vid01"}}], "_data": [], "id": 2, "type": "video"}], "id": 0}], "_data": [{"type": "metadata", "contents": [{"content": "Vanessa and the Customer Complaint", "type": "lesson_name"}, {"content": "A Letter of Complaint", "type": "unit_name"}, {"content": 8, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 2, "type": "lesson"}, {"content": "B1.3", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Describe complicated or unusual events in the past through a wider range of B1 language in both work and social contexts.", "type": "primary"}, {"content": "Writes well-organized texts or articles about explaining the rules and regulations in his/her industry using appropriate grammar, vocabulary, spelling coherence and cohesion, and different levels of formality. ", "type": "secondary_1"}, {"content": "Writes well-organized texts or articles about explaining the rules and regulations in his/her industry using appropriate grammar, vocabulary, spelling coherence and cohesion, and different levels of formality.", "type": "secondary_2"}, {"content": "Writes well-organized texts or articles about explaining the rules and regulations in his/her industry using appropriate grammar, vocabulary, spelling coherence and cohesion, and different levels of formality.", "type": "secondary_3"}, {"content": "Writes well-organized texts or articles about explaining the rules and regulations in his/her industry using appropriate grammar, vocabulary, spelling coherence and cohesion, and different levels of formality.", "type": "secondary_4"}, {"content": "Writes well-organized texts or articles about explaining the rules and regulations in his/her industry using appropriate grammar, vocabulary, spelling coherence and cohesion, and different levels of formality.", "type": "secondary_5"}, {"content": "Writes well-organized texts or articles about explaining the rules and regulations in his/her industry using appropriate grammar, vocabulary, spelling coherence and cohesion, and different levels of formality.", "type": "secondary_6"}, {"content": "Writes well-organized texts or articles about explaining the rules and regulations in his/her industry using appropriate grammar, vocabulary, spelling coherence and cohesion, and different levels of formality.", "type": "secondary_7"}, {"content": "Writes well-organized texts or articles about explaining the rules and regulations in his/her industry using appropriate grammar, vocabulary, spelling coherence and cohesion, and different levels of formality.", "type": "secondary_8"}]}, {"content": "engenn8le02ob08re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "Apologizing Using <span class=\"italic\">Should</span> and <span class=\"italic\">Supposed to</span>", "type": "heading"}, {"content": "You use <span class=\"italic\">should</span> and <span class=\"italic\">supposed to</span> to apologize for something you have done or to talk about obligations.", "type": "describer"}, {"content": "An obligation is something you should do or that other people expect you to do.<br/><br/> You use the verb \u201cto be\u201d in front of <span class=\"strong\">supposed to</span>:<br/> - verb \u201cto be\u201d + supposed to + verb<br/><br/> or<br/><br/> You can use the modal <span class=\"italic\">should</span> to also show obligation, duty and correctness.", "type": "text"}, {"content": "The waiter is supposed to take my order.", "type": "example"}, {"content": "I should have been more welcoming.", "type": "example"}, {"content": "What am I supposed to do now?", "type": "example"}, {"content": "The restaurant should apologize for their poor service.", "type": "example"}, {"content": "I was supposed to open the door for customers.", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "The Future with <span class=\"italic\">will, going to,</span> the Present Continuous and the Present Simple", "type": "heading"}, {"content": "You can use four different tenses to talk about the future.", "type": "describer"}, {"content": "<il><li>When you talk about a things that are not decided or when you make a decision at the moment of speaking for the future, you use the modal <span class=\"italic\">will</span>.<br/><br/> </li>  <li>When you ask about intentions, you use <span class=\"italic\">be going to.</span><br/><br/></li> <li>When you talk about things that are arranged, on the agenda or booked for the future, you use the Present Continuous tense.<br/><br/>  <li>When you talk about schedules or timetables in the future, you use the Simple Present tense.</li></ul>", "type": "text"}, {"content": "{\"rows\":6,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<div class=\\\"center_text\\\">Verb Tense</div>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<div class=\\\"center_text\\\"> Example</div>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Future Tense (Will)</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I will contact the newspaper that published your advertisement</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Going to</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I am going to write an online review of your restaurant.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Present Continuous Tense</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">We are planning to book a table at that new Italian restaurant later today.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Simple Present Tense</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I recommend that you organize a high chair before we arrive at 6 p.m.</span>\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}]}, {"type": "target_word", "contents": [{"content": "establishment", "type": "name"}, {"content": "a place or organization where people live or do business", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: We will never come back or recommend your establishment. ", "type": "example"}, {"content": "engenn8le02ob08aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you would use in a complaint letter.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "deceptive", "type": "name"}, {"content": "intended to make someone believe something that is not true", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: We are going to complete an online review so that others are wary of deceptive advertising techniques. ", "type": "example"}, {"content": "engenn8le02ob08aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "atrocious", "type": "name"}, {"content": "very evil or cruel", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: His atrocious behavior led to him being removed from the restaurant.", "type": "example"}, {"content": "engenn8le02ob08aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "scam", "type": "name"}, {"content": "a dishonest way to make money by deceiving people", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example:  I will be sure to spread the word to them and others about this scam", "type": "example"}, {"content": "engenn8le02ob08aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "crayon", "type": "name"}, {"content": "a stick of colored wax that is used for drawing", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example:  My daughter was not given a coloring book or crayons. ", "type": "example"}, {"content": "engenn8le02ob08aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "portion", "type": "name"}, {"content": "the amount of food that is served to a person at one time", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: You say that children that eat at Food and Fun are served child-sized portions.", "type": "example"}, {"content": "engenn8le02ob08aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "restless", "type": "name"}, {"content": "feeling nervous or bored and tending to move around a lot", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: She got restless and began to cry.", "type": "example"}, {"content": "engenn8le02ob08aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to chastise", "type": "name"}, {"content": "to criticize someone harshly for doing something wrong", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example:  I was even chastised for taking my daughter to a restaurant after 7p.m.!", "type": "example"}, {"content": "engenn8le02ob08aud08", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Interview a friend or family member about a time that they received poor service.", "type": "text"}, {"content": "Take detailed notes.", "type": "text"}, {"content": "Write a 120-150 word letter of complaint to the business based on your notes.", "type": "text"}, {"content": "Write sentences to explain what you will and won't be doing in the future. (Present Continuous tense, Future, <span class=\"italic\">Going to</span>, Present)", "type": "text"}, {"content": "Use the words should and supposed to describe what the business should have done.", "type": "text"}, {"content": "Proofread your work.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I interview a friend or family member about when they received poor service.", "type": "text"}, {"content": "I take detailed notes in a conversation.", "type": "text"}, {"content": "I write a letter of complaint.", "type": "text"}]}], "type": "sena"}