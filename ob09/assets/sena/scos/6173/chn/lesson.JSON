ns", "contents": [{"content": "Instructions: Click on the correct word to complete the sentence.", "type": "text"}]}, {"content": 2, "type": "template_override"}], "stimuli_ids": [], "template_override": 2, "id": 9, "type": "MRW"}, {"questions": [{"responses": [{"correct": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 1}], "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}], "stimuli_ids": [], "template_override": 1, "id": 10, "type": "RSLT"}, {"questions": [{"responses": [{"correct": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}], "_data": [{"type": "question", "contents": [{"content": "engenn8le02ob09re7pdf01.pdf", "type": "pdf"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": "Tell someone about your future.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Listening", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self Assessment.", "type": "text"}]}], "stimuli_ids": [], "template_override": 1, "id": 11, "type": "DWS"}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "type": "scholar", "stimuli": [{"type": "welcome", "_data": [], "template_override": 1, "contents": [{}], "id": 0}, {"id": 1, "template_override": 1, "title": "", "_data": [], "type": "audio", "contents": [{"type": "slideshow", "value": {"coverimg": "engenn8le02ob09re2img05.jpg", "audiosrc": "engenn8le02ob09re2aud01", "images": [{"time": "0", "image": "engenn8le02ob09re2img05.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn8le02ob09re2img05.jpg", "id": 1, "text": "<span class=\"strong\">Vanessa</span>: Good evening. Do you have a reservation?<br/>\n<span class=\"strong\">Customer</span>: No. I'm sorry. I was supposed to call but I forgot.<br/>\n<span class=\"strong\">Vanessa</span>: You should call for reservations. They are taken daily after 1 p.m.<br/>\n<span class=\"strong\">Customer</span>: You're right, I must call next time. My husband is going to be very upset.<br/>\n<span class=\"strong\">Vanessa</span>: So, you'll need a table for two? <br/>\n<span class=\"strong\">Customer</span>: Three. My husband is bringing his mother.<br/>\n<span class=\"strong\">Vanessa</span>: I'll see what I can do. When are they arriving?<br/>\n<span class=\"strong\">Customer</span>: They'll be here in about 15 minutes.<br/>\n<span class=\"strong\">Vanessa</span>: Hmm ... I'm sorry, we're supposed to have a table on reserve for emergencies."}, {"time": "28500", "image": "engenn8le02ob09re2img05.jpg", "id": 2, "text": "<span class=\"strong\">Customer</span>: I must apologize for inconveniencing you.<br/>\n<span class=\"strong\">Vanessa</span>: Wait here. Sorry, the table is being used. There will be a wait.<br/>\n<span class=\"strong\">Customer</span>: You mustn't apologize. You're so helpful!  I'm going to call Harold and tell him. They're not far. They take the subway. It runs every 15 minutes this time of night.\nHarold, can ... Yes, I know I was supposed to ... You must apologize to your mother for me. Yes, she'll say it's fine, but it won't be!"}, {"time": "60000", "image": "engenn8le02ob09re2img02.jpg", "id": 3, "text": "<span class=\"strong\">Vanessa</span>: Everything alright? <br/>\n<span class=\"strong\">Customer</span>: I don't suppose you know how  a mother-in-law can be?<br/>\n<span class=\"strong\">Vanessa</span>: Not really.<br/>\n<span class=\"strong\">Customer</span>: I think most can be irritating.<br/>\n<span class=\"strong\">Vanessa</span>: I'm not sure about that.<br/>\n<span class=\"strong\">Customer</span>: Trust me, they're exhausting. Mine is always disappointed. <br/>\n<span class=\"strong\">Vanessa</span>: That can't be true.<br/>\n<span class=\"strong\">Customer</span>: Anyway, I am sure dinner will be wonderful.<br/>\n<span class=\"strong\">Vanessa</span>: That's what I was going to say."}]}}]}], "id": 0}], "_data": [{"type": "metadata", "contents": [{"content": "Vanessa and the Customer Complaint", "type": "lesson_name"}, {"content": "You Should Make a Reservation", "type": "unit_name"}, {"content": 9, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 2, "type": "lesson"}, {"content": "B1.3", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Describe unusual events through a wider range of B1 language in both work and social contexts.", "type": "primary"}, {"content": "Understands important and specific information conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_1"}, {"content": "Understands important and specific information conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_2"}, {"content": "Understands important and specific information conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_3"}, {"content": "Understands important and specific information conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_4"}, {"content": "Understands important and specific information conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_5"}, {"content": "Understands important and specific information conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_6"}, {"content": "Understands important and specific information conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_7"}, {"content": "Understands important and specific information conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_8"}]}, {"type": "learning_points", "contents": [{"content": "Apologizing", "type": "heading"}, {"content": "When things go wrong when you are at work, you may have to apologize or accept an apology.", "type": "describer"}, {"content": "You can use use <span class=\"italic\">supposed to</span>, <span class=\"italic\">should</span> or <span class=\"italic\">must</span> when you apologize, explain what did not happen or to accept an apology.<br/><br/>  You use <span class=\"italic\">supposed to</span> when you want to show you/someone did not do what was expected.<br/><br/>  You use <span class=\"italic\">should</span> to show the action would be a good idea.<br/><br/>  You use <span class=\"italic\">must</span> to show there is an obligation or necessity.", "type": "text"}, {"content": "{\"rows\":2,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Example:\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Meaning:\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I'm sorry. I was supposed to call but I forgot.<br/><br/>  You really should call for reservations.<br/><br/>  You're right, I must call next time.<br/><br/>  Yes, I know I was supposed to ...<br/><br/>  You must apologize to your mother for me.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I'm apologizing because I do not do the expected thing.<br/><br/>  It would be a good idea to call next time.<br/><br/>  I have an obligation to call next time.<br/><br/>  I didn't do what was expected.<br/><br/>  You have an obligation to pass on the apology.\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": "I'm sorry, we're supposed to have a table on reserve for emergencies.", "type": "example"}, {"content": " I must apologize for inconveniencing you.", "type": "example"}, {"content": "Sorry, the table is being used. There will be a wait.", "type": "example"}, {"content": "You mustn't apologize.", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "The Future", "type": "heading"}, {"content": "You can use four different tenses to talk about the future.", "type": "describer"}, {"content": "When you talk about a things that are not decided or when you make a decision at the moment of speaking for the future, you use the modal <span class=\"italic\">will</span>.", "type": "text"}, {"content": "When you ask about intentions, you use <span class=\"italic\">be going to</span>.", "type": "text"}, {"content": "When you  talk about things that are arranged, on the agenda or booked for the future, you use the <span class=\"italic\">Present Continuous</span> tense.", "type": "text"}, {"content": "When you talk about schedules, you use the<span class=\"italic\"> Present Simple</span> tense for the future", "type": "text"}, {"content": "{\"rows\":8,\"columns\":1,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<div class=\\\"center_text\\\"><span class=\\\"strong\\\">Deciding Now</span></div>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">So, you'll need a table for two? <br/>They'll be here in about 15 minutes.<br/>I'll see what I can do.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<div class=\\\"center_text\\\"><span class=\\\"strong\\\">Intentions</span></div>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">My husband is going to be very upset.<br/>I'm going to call Harold and tell him.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<div class=\\\"center_text\\\"><span class=\\\"strong\\\">A Plan / Things On the Agenda</span></div>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">My husband is bringing his mother.<br/>When are they arriving?</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<div class=\\\"center_text\\\"><span class=\\\"strong\\\">Schedules</span></div>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Reservations are taken daily after 1 p.m.<br/>It runs every 15 minutes this time of night.</span>\\\"}\"],\"styles\":\" intro_table_border\"}", "type": "table"}]}, {"type": "target_word", "contents": [{"content": "to be upset", "type": "name"}, {"content": "to feel distress", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example:  My husband is going to be very upset.", "type": "example"}, {"content": "engenn8le02ob09aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use when you have problems with a restaurant reservation.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "on reserve", "type": "name"}, {"content": "kept as an extra for an emergency", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: We're supposed to have a table on reserve.", "type": "example"}, {"content": "engenn8le02ob09aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "emergency", "type": "name"}, {"content": " a sudden unexpected event that created problems ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: We save a table for emergencies.", "type": "example"}, {"content": "engenn8le02ob09aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to inconvenience", "type": "name"}, {"content": "to cause problems, delays, discomfort", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I must apologize for inconveniencing you.", "type": "example"}, {"content": "engenn8le02ob09aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "irritating", "type": "name"}, {"content": "annoying", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I think most mother-in-laws can be irritating.", "type": "example"}, {"content": "engenn8le02ob09aud05", "type": "audio"}]}, {"content": "engenn8le02ob09re1img01.jpg", "type": "background_image"}, {"type": "takeaway_extension", "contents": [{"content": "Think of the future in the next few years.", "type": "text"}, {"content": "Tell someone your intentions for the future (e.g. <span class=\"italic\">I am going to travel to Europe one day.</span>).", "type": "text"}, {"content": "Tell someone what plans you have made for the future (e.g. <span class=\"italic\">I am taking a course at university next year. I have planned it.</span>).", "type": "text"}, {"content": "Talk about any scheduled activities you have at a specific time this weekend (e.g. <span class=\"italic\">I work on Saturday afternoon.</span>).", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I talk about my intentions for the future.", "type": "text"}, {"content": "I talk about what my plans for the future.", "type": "text"}, {"content": "I write three sentences about my future.", "type": "text"}]}], "type": "sena"}