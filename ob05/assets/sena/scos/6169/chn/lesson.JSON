_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}]}, {"stimuli_ids": [], "type": "DWS", "questions": [{"responses": [{"correct": 1, "id": 0, "selected": 0, "_data": [{"type": "text", "content": ""}]}], "id": 0, "_data": [{"type": "question", "contents": [{"type": "pdf", "content": "engenn8le02ob05re7pdf01.pdf"}]}]}], "template_override": 1, "id": 11, "_data": [{"type": "instructions", "contents": [{"type": "text", "content": " Write about a bad restaurant experience."}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Take Away"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: Complete the following steps. Fill in the Self Assessment."}]}]}], "type": "scholar", "stimuli": [{"type": "welcome", "contents": [{}], "template_override": 1, "id": 0, "_data": []}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn8le02ob05re2img01.jpg", "audiosrc": "engenn8le02ob05re2aud01", "images": [{"time": "0", "image": "engenn8le02ob05re2img01.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn8le02ob05re2img01.jpg", "id": 1, "text": "<span class=\"strong\">Waiter</span>: Vanessa, there's a problem at table 5. <br/>\n<span class=\"strong\">Vanessa</span>: Not the one by the window!<br/>\n<span class=\"strong\">Waiter</span>: No, this is the one on the right, beside the wall.<br/>\n<span class=\"strong\">Vanessa</span>: What's the problem?<br/>\n<span class=\"strong\">Waiter</span>: They say they are not eating one more bite of their cheesecake. They say it's not edible. They say it's not fit for human consumption!<br/>\n<span class=\"strong\">Vanessa</span>: I'd better go right over. You should come as well.<br/>\n<span class=\"strong\">Waiter</span>: Alright. <br/>"}, {"time": "21000", "image": "engenn8le02ob05re2img05.jpg", "id": 2, "text": "<span class=\"strong\">Vanessa</span>: Sir, I'm so sorry you felt you had to complain. What is the problem?<br/>\n<span class=\"strong\">Customer</span>: The cheesecake is disgusting. You have to try it. You mustn't let anyone else have any!<br/>\n<span class=\"strong\">Vanessa</span>: Do you mind if I taste it? <br/>\n<span class=\"strong\">Customer</span>: I promise it does not taste the way you would expect it to!<br/>\n<span class=\"strong\">Vanessa</span>: Oh! You're right! Angela, you must take the cheesecake away immediately. You have to find the rest of it as well, please. You should also put all the cheesecake aside until we've sorted the problem out.<br/"}, {"time": "48700", "image": "engenn8le02ob05re2img05.jpg", "id": 3, "text": "<span class=\"strong\">Waiter</span>: Yes, I will.<br/>\n<span class=\"strong\">Vanessa</span>: Sir, I agree that is sickening. You must feel nauseated if you ate more than one bite!<br/>\n<span class=\"strong\">Customer</span>: We did not, thank goodness. <br/>\n<span class=\"strong\">Vanessa</span>: You must be quite displeased with us. It must be extremely disappointing after your meal! Can I please offer you another dessert? Of course there will not be any charge for your meal!<br/>\n<span class=\"strong\">Customer</span>: Usually your desserts are far above-standard.  <br/>\n<span class=\"strong\">Vanessa</span>: I do apologize and I hope you will not hold this against us.<br/>"}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}], "id": 0, "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Vanessa and the Customer Complaint"}, {"type": "unit_name", "content": "Unhappy Customers"}, {"type": "position", "content": 5}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 2}, {"type": "level", "content": "B1.3"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Describe unusual events through a wider range of B1 language in both work and social contexts."}, {"type": "secondary_1", "content": "Understands important and specific information conversations, texts or presentations about the communicative functions related to this level."}, {"type": "secondary_2", "content": "Understands important and specific information conversations, texts or presentations about the communicative functions related to this level."}, {"type": "secondary_3", "content": "Understands important and specific information conversations, texts or presentations about the communicative functions related to this level."}, {"type": "secondary_4", "content": "Understands important and specific information conversations, texts or presentations about the communicative functions related to this level."}, {"type": "secondary_5", "content": "Understands important and specific information conversations, texts or presentations about the communicative functions related to this level."}, {"type": "secondary_6", "content": "Understands important and specific information conversations, texts or presentations about the communicative functions related to this level."}, {"type": "secondary_7", "content": "Understands important and specific information conversations, texts or presentations about the communicative functions related to this level."}, {"type": "secondary_8", "content": "Understands important and specific information conversations, texts or presentations about the communicative functions related to this level."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Dealing with Difficult Customers"}, {"type": "describer", "content": "When you are dealing with customers in restaurants, you may have to apologize."}, {"type": "text", "content": "When you apologize you can show that you understand how they are feeling with:<br/><br/>You must ... + adjective + ed<br/>It must ... + adjective + ing"}, {"type": "example", "content": "I agree that is <span class=\"strong\">sickening</span>."}, {"type": "example", "content": "You must feel <span class=\"strong\">nauseated</span> if you ate more than one bite!"}, {"type": "example", "content": "You must be quite <span class=\"strong\">displeased</span> with us. "}, {"type": "example", "content": "It must be extremely <span class=\"strong\">disappointing</span> after your meal!"}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "The Position of <span class=\"italic\">Not</span>"}, {"type": "describer", "content": "When you want to emphasize that something or an action is opposite to what is expected, use <span class=\"italic\">not</span>, rather than a contraction in the sentence.<br/><br/>For example:<br/> <span class=\"italic\">They say they will <span class=\"strong\">not</span> eat any more of it.<br/> Sir, I hope you will <span class=\"strong\">not</span> hold this against us.</span><br/><br/>  The word <span class=\"italic\"><span class=\"strong\">not</span></span> shows firmness on the part of the speaker while still being polite."}, {"type": "table", "content": "{\"rows\":2,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<div class=\\\"center_text\\\">Statement</div>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<div class=\\\"center_text\\\">Meaning</div>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">They say they are not eating one more bite of their cheesecake. <br/><br/>  They say it's not edible. <br/><br/>  They say it's not fit for human consumption!<br/><br/>  I promise it does not taste the way you would expect it to!<br/><br/>  We did not, thank goodness.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"They refuse to eat the cheesecake.<br/><br/> <br/>  No one can eat this.<br/><br/>  This is unsafe to eat.<br/><br/>   The taste is opposite to what you would expect.<br/><br/>   We're happy we refused.<br/><br/>\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "fit for human consumption"}, {"type": "definition", "content": "safe to eat"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: It's not fit for human consumption!"}, {"type": "audio", "content": "engenn8le02ob05aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you use when you have problems in a restaurant."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to expect"}, {"type": "definition", "content": "to believe something will happen"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: It does not taste the way you would expect it to!"}, {"type": "audio", "content": "engenn8le02ob05aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "rest"}, {"type": "definition", "content": "the remaining part"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: You have to find the rest of it as well, please."}, {"type": "audio", "content": "engenn8le02ob05aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to sort out"}, {"type": "definition", "content": "to deal with; to find the reason for"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: You should also put all the cheesecake aside until I've sorted the problem out."}, {"type": "audio", "content": "engenn8le02ob05aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "sickening"}, {"type": "definition", "content": "making you feel ill"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: Sir, I agree that is sickening."}, {"type": "audio", "content": "engenn8le02ob05aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "nauseated"}, {"type": "definition", "content": "feeling as if you may vomit"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: You must feel nauseated."}, {"type": "audio", "content": "engenn8le02ob05aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "displeased"}, {"type": "definition", "content": "unhappy"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: You must be quite displeased with us. "}, {"type": "audio", "content": "engenn8le02ob05aud07"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "above standard"}, {"type": "definition", "content": "higher quality than expected"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: Usually your desserts are far above-standard. "}, {"type": "audio", "content": "engenn8le02ob05aud08"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to hold against"}, {"type": "definition", "content": "to think badly of"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: I do apologize and hope you will not hold this against us."}, {"type": "audio", "content": "engenn8le02ob05aud09"}]}, {"type": "background_image", "content": "engenn8le02ob05re1img01.jpg"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Tell someone about eating in a restaurant where something was wrong with the food or service."}, {"type": "text", "content": "Write a few lines to explain why you were disappointed."}, {"type": "text", "content": "Write a few more lines to say what the restaurant should/ought to/had better do differently."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I talk about the food and service in a restaurant."}, {"type": "text", "content": "I explain why it was not very good."}, {"type": "text", "content": "I explain what the restaurant needs to do to improve the food and service."}]}]}