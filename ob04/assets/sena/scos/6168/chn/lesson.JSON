nts": [{"type": "text", "content": " Plan a party!"}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Take Away"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: Complete the following steps. Fill in the Self Assessment."}]}]}], "type": "scholar", "stimuli": [{"type": "welcome", "contents": [{}], "template_override": 1, "id": 0, "_data": []}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn8le02ob04re2img01.jpg", "audiosrc": "engenn8le02ob04re2aud01", "images": [{"time": "0", "image": "engenn8le02ob04re2img01.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn8le02ob04re2img01.jpg", "id": 1, "text": "<span class=\"strong\">Host</span>: Come along with me, Ms. Scenario. Do you like  what we have come up with for the Science and Scientists dinner?<br/>\n<span class=\"strong\">Ms. Scenario</span>: I see you took my advice and had the stairs ascend in the center to a crescent-shaped head table. Is it possible to descend on either side as well?<br/>\n<span class=\"strong\">Host</span>: Yes, Ms. Scenario. <br/>\n<span class=\"strong\">Ms. Scenario</span>: The luminescence of the small fluorescent lights is delightful."}, {"time": "18000", "image": "engenn8le02ob04re2img02.jpg", "id": 2, "text": "<span class=\"strong\">Host</span>: Have you noticed how we mounted scenes from scientific discoveries on large isosceles triangles on the wall?<br/>\n<span class=\"strong\">Ms. Scenario</span>: Fascinating! I knew I could count on you to pull this dinner off! Is there a scent in the room as well?<br/>\n<span class=\"strong\">Host</span>: Yes, a slight one. Does it meet with your approval?<br/>\n<span class=\"strong\">Ms. Scenario</span>: It's interesting, but we could do without it.<br/>\n<span class=\"strong\">Host</span>: Would you like to go over the menu again? The starters, the main course, and dessert?"}, {"time": "41000", "image": "engenn8le02ob04re2img03.jpg", "id": 3, "text": "<span class=\"strong\">Ms. Scenario</span>: I'm sure it's fine. I've heard back from everyone. It's a full house!<br/>\n<span class=\"strong\">Host</span>: As promised, we will clean up quickly after dinner and clear away the tables.<br/>\n<span class=\"strong\">Ms. Scenario</span>: That can happen right after we give out the miscellaneous awards.<br/>\n<span class=\"strong\">Host</span>: Can we light up the candles and bring in the small orchestra then? <br/>\n<span class=\"strong\">Ms. Scenario</span>: Yes. We'll carry on our evening with cocktails, nibbles and dancing!"}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}], "id": 0, "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Vanessa and the Customer Complaint"}, {"type": "unit_name", "content": "The Science and Scientists Dinner"}, {"type": "position", "content": 4}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 2}, {"type": "level", "content": "B1.3"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Describe unusual events through a wider range of B1 language in both work and social contexts."}, {"type": "secondary_1", "content": "Understands important and specific information conversations, texts or presentations about the communicative functions related to this level."}, {"type": "secondary_2", "content": "Understands important and specific information conversations, texts or presentations about the communicative functions related to this level."}, {"type": "secondary_3", "content": "Understands important and specific information conversations, texts or presentations about the communicative functions related to this level."}, {"type": "secondary_4", "content": "Understands important and specific information conversations, texts or presentations about the communicative functions related to this level."}, {"type": "secondary_5", "content": "Understands important and specific information conversations, texts or presentations about the communicative functions related to this level."}, {"type": "secondary_6", "content": "Understands important and specific information conversations, texts or presentations about the communicative functions related to this level."}, {"type": "secondary_7", "content": "Understands important and specific information conversations, texts or presentations about the communicative functions related to this level."}, {"type": "secondary_8", "content": "Understands important and specific information conversations, texts or presentations about the communicative functions related to this level."}]}, {"type": "background_image", "content": "engenn8le02ob04re1img01.jpg"}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Pronouncing Silent Letter Words"}, {"type": "describer", "content": "Silent letters are letters that appear in a particular word but they are not pronounced when the word is said. The '<span class=\"underline\">c</span>' is sometimes silent in English when it follows  an <span class=\"underline\">s</span> in a word."}, {"type": "text", "content": "When you pronounce these words, you pronounce the <span class=\"italic\">s</span>, but not the <span class=\"italic\">c</span>. <br/><br/>science<br/>   scientist<br/>  scene<br/>  scent<br/> ascend<br/>  crescent<br/>  descend<br/>  fascinate<br/>  fluorescent <br/> isosceles<br/>  luminescent<br/>  miscellaneous<br/>  scenario"}, {"type": "example", "content": "I see you took my advice and had the stairs ascend in the center to a crescent-shaped head table."}, {"type": "example", "content": "Is it possible to descend on either side as well?"}, {"type": "example", "content": "The luminescence of the small fluorescent lights is delightful."}, {"type": "example", "content": "Have you noticed how we mounted scenes from scientific discoveries on large isosceles triangles on the wall?"}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "The Pronunciation of Phrasal Verbs"}, {"type": "describer", "content": "Where do you put the stress in a phrasal verb?"}, {"type": "text", "content": "If the phrasal verb is not separable, then you stress the verb.<br/><br/>Example: <span class=\"italic\"><span class=\"strong\">go</span> over<br/> Let's <span class=\"strong\">go</span> over the menu.</span> (go over - is not finished without the object <span class=\"italic\">menu</span>.)<br/> <span class=\"italic\">I didn't <span class=\"strong\">hear</span> back.</span><br/><br/>  If the Phrasal verb is separable, then the stress is on the particle (preposition).<br/><br/>  Example: <span class=\"italic\">pull <span class=\"strong\">off</span></span><br/> <span class=\"italic\">I knew you could pull this party <span class=\"strong\">off</span>!<span class=\"italic\">"}, {"type": "example", "content": "<span class=\"italic\">Would you like to <span class=\"strong\">go</span> over the menu again?</span>"}, {"type": "example", "content": "<span class=\"italic\">I've <span class=\"strong\">heard</span> back from everyone.</span>"}, {"type": "example", "content": "<span class=\"italic\">As promised, we will clean <span class=\"strong\">up</span> quickly after dinner and clear <span class=\"strong\">away</span> the tables.</span>"}, {"type": "example", "content": "<span class=\"italic\">That can happen right after we give <span class=\"strong\">out</span> the miscellaneous awards.</span>"}, {"type": "example", "content": "<span class=\"italic\">Can we light <span class=\"strong\">up</span> the candles and bring <span class=\"strong\">in</span> the small orchestra then? </span>"}, {"type": "example", "content": "<span class=\"italic\">We'll <span class=\"strong\">carry</span> on our evening with cocktails, nibbles and dancing!</span>"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to ascend"}, {"type": "definition", "content": "to go up"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: You ascend the steps in the center."}, {"type": "audio", "content": "engenn8le02ob04aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you use to talk about an event."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to descend"}, {"type": "definition", "content": "to go down"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: You can descend the stairs on either side of the stage."}, {"type": "audio", "content": "engenn8le02ob04aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "luminescence"}, {"type": "definition", "content": "a soft light"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The luminescence of the small lights is delightful."}, {"type": "audio", "content": "engenn8le02ob04aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "fluorescent"}, {"type": "definition", "content": "producing a bright light, usually from tube-shaped bulbs"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: These lights are fluorescent."}, {"type": "audio", "content": "engenn8le02ob04aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to pull off"}, {"type": "definition", "content": "to manage to do something difficult"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: I knew I could count on you to pull this dinner off!"}, {"type": "audio", "content": "engenn8le02ob04aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to do without"}, {"type": "definition", "content": "to manage without having"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: It's interesting, but we could do without it."}, {"type": "audio", "content": "engenn8le02ob04aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to clear away"}, {"type": "definition", "content": "to remove things"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: After dinner we'll clear away the tables."}, {"type": "audio", "content": "engenn8le02ob04aud07"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "miscellaneous"}, {"type": "definition", "content": "various"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: We're going to give out the miscellaneous awards."}, {"type": "audio", "content": "engenn8le02ob04aud08"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Think of a good reason for planning a party."}, {"type": "text", "content": "Discuss the things you will need for the party including the menu and decorations and gifts for the guests."}, {"type": "text", "content": "Write a paragraph describing the plan for the party."}, {"type": "text", "content": "Use at least two phrasal verbs and two <span class=\"italic\">SC</span> words. "}, {"type": "text", "content": "Read your paragraph and add any other ideas you come up with."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I discuss the planning of a party."}, {"type": "text", "content": "I write out a plan."}, {"type": "text", "content": "I use <span class=\"italic\">SC</span> words."}, {"type": "text", "content": "I read my paragraph."}]}]}